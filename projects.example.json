{
  "my-app": {
    "root": "C:\\path\\to\\my-app",
    "mode": "direct",
    "sdks": ["git", "pnpm", "npm", "http", "fs_read"],
    "allowedScripts": ["test", "lint", "build"],
    "deny": ["docs/private/**"],
    "description": "可读写项目：允许 apply_patch 与 exec_verify"
  },
  "reference-lib": {
    "root": "C:\\path\\to\\reference-lib",
    "mode": "readonly",
    "sdks": ["fs_read"],
    "description": "只读项目：拒绝 apply_patch，仅保留只读 SDK"
  }
}
