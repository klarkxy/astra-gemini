{
  "name": "astra-gemini-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_ID" }
  ],
  "vars": {
    "UPSTREAM_MCP_URL": "https://astra.klarkxy.xyz/mcp",
    "PUBLIC_ORIGIN": ""
  },
  "observability": { "enabled": true }
}
